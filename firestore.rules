rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Healthcheck test document
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if isAdmin();
    }

    // Validation helper for Orders
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() <= 30
        && data.orderType in ['Dine-in', 'Pick-up', 'Delivery']
        && data.items is list && data.items.size() > 0 && data.items.size() <= 30
        && data.totalETB is number && data.totalETB >= 0
        && data.status in ['received', 'brewing', 'ready', 'completed']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    match /orders/{orderId} {
      allow read: if isValidId(orderId) && (
        (isSignedIn() && existing().userId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidId(orderId) && isValidOrder(incoming())
        && (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Validation helper for Ceremony Bookings
    function isValidBooking(data) {
      return data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 30
        && data.date is string && data.date.size() <= 20
        && data.time is string && data.time.size() <= 20
        && data.guests is number && data.guests >= 1 && data.guests <= 20
        && data.packageType in ['classic', 'royal', 'masterclass']
        && data.status in ['confirmed', 'completed', 'cancelled']
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    match /ceremony_bookings/{bookingId} {
      allow read: if isValidId(bookingId) && (
        (isSignedIn() && existing().userId == request.auth.uid) || isAdmin()
      );
      allow create: if isValidId(bookingId) && isValidBooking(incoming())
        && (!('userId' in incoming()) || (isSignedIn() && incoming().userId == request.auth.uid));
      allow update: if isValidId(bookingId) && isAdmin();
      allow delete: if isValidId(bookingId) && isAdmin();
    }
  }
}
